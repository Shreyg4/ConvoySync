# Connect to Supabase via connection pooling
DATABASE_URL=

# Direct connection to the database. Used for migrations
DIRECT_URL=

# Secret used to sign JWTs (any long random string)
JWT_SECRET=

# ---------------------THESE MAY CHANGE IF ENES HOSTS THE BACKEND----------------------
# Public base URL of THIS backend. Must match the redirect/callback URLs
# registered in the Google/GitHub consoles. 
BACKEND_URL=http://localhost:8080

# Web frontend base URL. Used as the fallback OAuth redirect (the /auth/callback
# page) when no app redirect_uri is supplied. The mobile app supplies its own.
FRONTEND_URL=http://localhost:3000
#---------------------------------------------------------------------------------------

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client, "Web application")
# Authorized redirect URI: <BACKEND_URL>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (GitHub -> Settings -> Developer settings -> OAuth Apps)
# Authorization callback URL: <BACKEND_URL>/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

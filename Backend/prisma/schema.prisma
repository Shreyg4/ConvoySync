// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  pwHash    String
  createdAt DateTime @default(now())

  ownedTrips Trip[]       @relation("TripOwner")
  inTrips    TripMember[]

  tripStatuses    MemberTripStatus[]
  rerouteRequests RerouteRequest[]
  rerouteVotes    RerouteVote[]
}

model TripMember {
  tripId   Int
  userId   Int
  role     String
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([tripId, userId])
}

enum TripStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

model Trip {
  id         Int        @id @default(autoincrement())
  ownerId    Int
  name       String
  inviteCode String     @unique
  estStart   DateTime
  status     TripStatus @default(PLANNED)
  createdAt  DateTime   @default(now())

  startLocationId  Int?
  startLocation   Location? @relation("TripStartLocation", fields: [startLocationId], references: [id])

  owner User @relation("TripOwner", fields: [ownerId], references: [id])

  members         TripMember[]
  itinerary       Itinerary?
  memberStatuses  MemberTripStatus[]
  rerouteRequests RerouteRequest[]
}

model Itinerary {
  id     Int @id @default(autoincrement())
  tripId Int @unique

  trip  Trip            @relation(fields: [tripId], references: [id])
  stops ItineraryStop[]
}

model Location {
  id        Int    @id @default(autoincrement())
  name      String
  address   String
  latitude  Float
  longitude Float

  tripStarts      Trip[] @relation("TripStartLocation")
  stops           ItineraryStop[]
  rerouteRequests RerouteRequest[]
}

model ItineraryStop {
  id          Int      @id @default(autoincrement())
  itineraryId Int
  locationId  Int
  stopOrder   Int
  eta         DateTime

  itinerary Itinerary @relation(fields: [itineraryId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])

  memberStatuses MemberTripStatus[]
}

enum MemberStatus {
  ENROUTE
  DELAYED
  STOPPED
  ARRIVED
}

model MemberTripStatus {
  id     Int  @id @default(autoincrement())
  tripId Int
  userId Int
  stopId Int?

  status      MemberStatus
  currentLat  Float?
  currentLong Float?
  eta         DateTime?
  updatedAt   DateTime     @updatedAt

  trip Trip           @relation(fields: [tripId], references: [id])
  user User           @relation(fields: [userId], references: [id])
  stop ItineraryStop? @relation(fields: [stopId], references: [id])

  @@unique([tripId, userId])
}

enum RerouteStatus {
  ACCEPTED
  PENDING
  REJECTED
}

model RerouteRequest {
  id     Int @id @default(autoincrement())
  tripId Int
  userId Int
  locId  Int

  status    RerouteStatus @default(PENDING)
  etaImpact Int
  createdAt DateTime      @default(now())
  expiresAt DateTime

  trip     Trip     @relation(fields: [tripId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  location Location @relation(fields: [locId], references: [id])

  votes RerouteVote[]
}

enum Vote {
  YES
  NO
}

model RerouteVote {
  id        Int @id @default(autoincrement())
  requestId Int
  userId    Int

  vote    Vote
  votedAt DateTime @default(now())

  reroute RerouteRequest @relation(fields: [requestId], references: [id])
  user    User           @relation(fields: [userId], references: [id])

  @@unique([requestId, userId])
}

# Base URL of the ConvoySync backend, used for ALL API calls (auth, trips, itinerary).
# Defaults to the hosted backend; change it only if you self-host the server.
EXPO_PUBLIC_API_URL=https://convoysync.onrender.com

# Google Maps API key (with the Places API and Directions API enabled) for the map/search screens.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
